{
  "tagOwners": {
    "tag:lab": [],
    "tag:k8s-operator": [],
    "tag:k8s": ["tag:k8s-operator"]
  },

  "grants": [
    {
      "src": ["*"],
      "dst": ["*"],
      "ip": ["*"]
    },
    {
      "src": ["tailscale_login"],
      "dst": ["tag:k8s"],
      "ip": ["tcp:80", "tcp:443"]
    }
  ],

  "ssh": [
    {
      "action": "check",
      "src": ["autogroup:member"],
      "dst": ["autogroup:self"],
      "users": ["autogroup:nonroot", "root"]
    },
    {
      "action": "check",
      "src": ["tailscale_login"],
      "dst": ["tag:lab"],
      "users": ["laborant", "root"]
    }
  ],

  "autoApprovers": {
    "services": {
      "svc:lab-k0s": ["tag:k8s"]
    }
  }
}
