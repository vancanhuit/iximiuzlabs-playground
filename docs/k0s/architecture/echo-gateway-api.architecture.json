  "cards": [
    {
      "dot": "violet",
      "title": "Private request invariant",
      "items": [
        "Cloudflare publishes DNS but never proxies application traffic",
        "The Tailscale proxy forwards TCP to Envoy's generated Service"
      ]
    },
    {
      "dot": "emerald",
      "title": "Automated lifecycle",
      "items": [
        "ExternalDNS synchronizes owned records from accepted Gateway API routes",
        "cert-manager renews the certificate through Cloudflare DNS-01"
      ]
    },
    {
      "dot": "amber",
      "title": "Controller ownership",
      "items": [
        "Envoy Gateway creates the Envoy Deployment, Service, and xDS config",
        "Tailscale observes that Service and creates the external proxy identity"
      ]
    },
    {
      "dot": "rose",
      "title": "Client address limit",
      "items": [
        "Envoy sees the Tailscale proxy Pod as its TCP peer",
        "Do not trust client XFF or enable PROXY protocol without a sender"
      ]
    }
  ]
