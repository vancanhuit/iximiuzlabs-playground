      "isDeleted": false,
      "boundElements": null,
      "updated": 1791551548148,
      "link": null,
      "locked": false,
      "text": "Storage is ephemeral: no StorageClass or persistent volumes in this setup.\nMetrics, silences and Grafana database changes can be lost when Pods are replaced.",
      "fontSize": 22,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": "box-20",
      "originalText": "Storage is ephemeral: no StorageClass or persistent volumes in this setup.\nMetrics, silences and Grafana database changes can be lost when Pods are replaced.",
