      "versionNonce": 970326482,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1791551548148,
      "link": null,
      "locked": false,
      "text": "DNS + CERTIFICATES\n\nExternalDNS syncs 3 A records and ownership TXT in Cloudflare.\ncert-manager uses DNS-01 and stores 3 ECDSA TLS Secrets.\nEnvoy loads one certificate per HTTPS listener.",
      "fontSize": 22,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": "box-19",
      "originalText": "DNS + CERTIFICATES\n\nExternalDNS syncs 3 A records and ownership TXT in Cloudflare.\ncert-manager uses DNS-01 and stores 3 ECDSA TLS Secrets.\nEnvoy loads one certificate per HTTPS listener.",
      "autoResize": true,
      "lineHeight": 1.35
    },
    {
      "id": "EXhE7ID_1ZnAbyXlucMEr",
      "type": "text",
      "x": 64,
