      "updated": 1791551546533,
      "link": null,
      "locked": false,
      "text": "Cloudflare hosts DNS only; it never proxies Hubble application traffic.\nNGINX sees the proxy Pod IP, not the original tailnet client IP.",
      "fontSize": 22,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": "box-22",
      "originalText": "Cloudflare hosts DNS only; it never proxies Hubble application traffic.\nNGINX sees the proxy Pod IP, not the original tailnet client IP.",
      "autoResize": true,
      "lineHeight": 1.35
    }
