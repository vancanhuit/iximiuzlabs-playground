  "cards": [
    {
      "dot": "violet",
      "title": "Request invariant",
      "items": [
        "Cloudflare answers DNS but never proxies application traffic",
        "Only a tailnet-authorized client can route to the 100.x Service address"
      ]
    },
    {
      "dot": "emerald",
      "title": "Certificate lifecycle",
      "items": [
        "DNS-01 validates the hostname without exposing Hubble UI publicly",
        "cert-manager renews the Secret and ingress-nginx reloads it automatically"
      ]
    },
    {
      "dot": "amber",
      "title": "Ownership",
      "items": [
        "Cilium owns Hubble UI; ingress-nginx owns TLS termination",
        "Tailscale owns private reachability; cert-manager owns ACME state"
      ]
    }
