    {
      "dot": "violet",
      "title": "Request path",
      "items": [
        "Cloudflare answers DNS but does not proxy application traffic",
        "Tailscale forwards TCP to the Service selecting ingress-nginx",
        "ingress-nginx sees a proxy Pod IP; tailnet grants authorize clients"
      ]
    },
    {
      "dot": "emerald",
      "title": "Certificate lifecycle",
      "items": [
        "DNS-01 validates the hostname without public Hubble exposure",
        "cert-manager renews the Secret and ingress-nginx reloads it"
      ]
    },
    {
      "dot": "amber",
      "title": "Provisioning ownership",
      "items": [
        "Helm installs ingress-nginx; Ingress objects configure its routes",
