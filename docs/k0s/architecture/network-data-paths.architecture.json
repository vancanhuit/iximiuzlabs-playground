  "cards": [
    {
      "dot": "cyan",
      "title": "Service translation",
      "items": [
        "ClusterIP 10.96.0.0/12 is virtual; eBPF selects a Pod backend",
        "socketLB.hostNamespaceOnly sends Pod service lookup to tc on the veth",
        "NodePort direct-routing device is tailscale0; default mode is SNAT"
      ]
    },
    {
      "dot": "violet",
      "title": "Encapsulation and return",
      "items": [
        "Cross-node inner Pod packet keeps 10.244 source and destination IPs",
        "VXLAN adds 50 bytes; Tailscale encrypts the outer node packet",
        "Reply traffic follows reverse policy, conntrack, decap, and veth stages"
      ]
    },
    {
      "dot": "amber",
      "title": "Routing invariants",
      "items": [
        "Never advertise 10.244.0.0/16 or 10.96.0.0/12 through Tailscale",
        "tailscale0 MTU stays 1280 and Cilium MTU stays 1230",
        "Controllers run no workloads; Pod endpoints exist on five workers"
      ]
    }
  ]
