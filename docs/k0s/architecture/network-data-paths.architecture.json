  "cards": [
    {
      "dot": "cyan",
      "title": "What is inside what?",
      "items": [
        "Inner packet remains 10.244.1.10 → 10.244.2.20",
        "Cilium adds node IP 100.x → 100.y, UDP 8472, and VXLAN",
        "Tailscale encrypts and transports that complete outer packet"
      ]
    },
    {
      "dot": "violet",
      "title": "At Worker B",
      "items": [
        "Tailscale decrypts and delivers the VXLAN packet",
        "Cilium decapsulates, applies policy, and routes to the veth",
        "Replies are independently encapsulated and encrypted in reverse"
      ]
    },
    {
      "dot": "amber",
      "title": "Routing and MTU invariants",
      "items": [
        "Tailscale routes node 100.x addresses, not 10.244.0.0/16",
        "Cilium MTU 1230 + VXLAN 50 bytes = tailscale0 MTU 1280",
        "Same-node traffic branches before VXLAN and tailscale0"
      ]
    }
